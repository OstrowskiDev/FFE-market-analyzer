{
  "name": "project-47-ffe-market-analyzer",
  "type": "module",
  "version": "1.0.0",
  "description": "FFE market analyzer tool",
  "main": "build/src/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && node scripts/build/postbuild.js",
    "bundle": "node scripts/build/bundle.js",
    "build:standalone": "npm run build && npm run bundle",
    "start": "node build/src/main.js",
    "build:run": "npm run build && npm run start",
    "package:win": "pkg dist/bundle.cjs --targets node20-win-x64 --output dist/FFE-market-analyzer-win.exe",
    "package:linux": "pkg dist/bundle.cjs --targets node20-linux-x64 --output dist/FFE-market-analyzer-linux",
    "assemble:dist": "node scripts/build/assemble-dist.js",
    "build:release": "npm run build && npm run bundle && npm run package:win && npm run package:linux && npm run assemble:dist"
  },
  "engines": {
    "node": "20.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OstrowskiDev/FFE-market-analyzer.git"
  },
  "author": "Marcin Ostrowski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OstrowskiDev/FFE-market-analyzer/issues"
  },
  "homepage": "https://github.com/OstrowskiDev/FFE-market-analyzer#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "jimp": "^1.6.1",
    "ocr-space-api-wrapper": "^2.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@yao-pkg/pkg": "^6.14.2",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.1",
    "knip": "^6.14.2",
    "typescript": "^6.0.3"
  }
}
